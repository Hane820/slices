---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPublishedWriting, getCategories, categorySlug } from '../../lib/content';
export async function getStaticPaths(){
  const writing = await getPublishedWriting();
  return getCategories(writing).map((category) => ({
    params: { category: categorySlug(category) },
    props: { category, entries: writing.filter((entry) => entry.data.category === category) },
  }));
}
const { category, entries } = Astro.props;
---
<BaseLayout title={`${category} · Fourfold`}><header class="page-head container"><p class="eyebrow">Category</p><h1>{category}</h1><p>{entries.length} 篇相关写作</p></header><section class="container list">{entries.map((entry: any) => <PostCard entry={entry} />)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(3rem,10vw,7rem);line-height:.9;letter-spacing:-.07em;margin:.4rem 0}.page-head p{color:var(--muted)}</style>
