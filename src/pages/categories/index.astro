---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedWriting, getCategories, categoryPath } from '../../lib/content';
const writing = await getPublishedWriting();
const categories = getCategories(writing).map((category) => ({
  category,
  count: writing.filter((entry) => entry.data.category === category).length,
}));
---
<BaseLayout title="分类 · Fourfold" description="按主题浏览写作。"><header class="page-head container"><p class="eyebrow">Categories</p><h1>把写过的，放到一起。</h1><p>共 {categories.length} 个分类入口，只列出实际使用的分类。</p></header><section class="container tag-cloud">{categories.map(({ category, count }) => <a href={categoryPath(category)}>{category} <sup>{count}</sup></a>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.tag-cloud{display:flex;flex-wrap:wrap;gap:.8rem 1.2rem;border-top:1px solid var(--line);padding-top:2rem}.tag-cloud a{font-size:1.2rem;color:var(--accent)}.tag-cloud sup{font-size:.7em;color:var(--muted)}</style>
